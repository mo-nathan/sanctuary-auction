#!/usr/bin/bash
set -euo pipefail

# Run on the server from any directory. It has three steps. To choose when the
# site switches over, run the build commands first and the switch commands
# later, from /opt/sanctuary-auction.
cd "$(dirname "$0")/.."

# Build: get the latest code and build a new web image. This is the slow part,
# and the site keeps running on the current container the whole time.
git pull

# Record what this image holds, so bin/hotfix can tell what a running container
# is missing. It reaches the image through the COPY in the Dockerfile.
git rev-parse HEAD > REVISION

docker compose build

# Switch: replace the running web container with one from the new image. The
# site is down until the new one boots, which first runs any pending database
# migrations.
docker compose up -d

# Cleanup: delete the old image, which nothing uses anymore.
docker image prune -f
