# Copy to .env on the server. Use hex values, since the password is part of a URL:
#   openssl rand -hex 32   (POSTGRES_PASSWORD)
#   openssl rand -hex 64   (SECRET_KEY_BASE)

APP_HOST=auction.collectivesource.com
POSTGRES_DB=project_production
POSTGRES_USER=rails
POSTGRES_PASSWORD=
SECRET_KEY_BASE=
TZ=UTC
