<%= form_with model: tag do |form| %>
  <div class="mt-3">
    <%= form.label :group %><br>
    <%= form.text_field :group, size: 60 %>
    <%= field_errors(form, :group) %>
  </div>
  <div class="mt-3">
    <%= form.label :name %><br>
    <%= form.text_field :name, size: 60 %>
    <%= field_errors(form, :name) %>
  </div>

  <div class="mt-3">
    <%= form.submit %>
  </div>
<% end %>
