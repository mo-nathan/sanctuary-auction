<%= form_with model: user do |form| %>
  <div class="mt-3">
    <%= form.label :code %><br>
    <%= form.text_field :code %>
    <%= field_errors(form, :code) %>
  </div>

  <div class="mt-3">
    <%= form.label :name %><br>
    <%= form.text_field :name %>
    <%= field_errors(form, :name) %>
  </div>

  <div class="mt-3">
    <%= form.submit %>
  </div>
<% end %>
