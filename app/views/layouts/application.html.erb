<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for?(:title) ? "#{yield(:title)} | Anti-Capitalist Community Auction" : "Anti-Capitalist Community Auction" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", defer: true %>
  </head>

  <body>
    <% if flash.any? %>
      <div role="region" aria-label="Messages">
        <% flash.each do |type, msg| %>
          <div class="alert alert-<%= class_from_type(type) %>" role="<%= type == 'notice' ? 'status' : 'alert' %>">
            <%= msg %>
          </div>
        <% end %>
      </div>
    <% end %>

    <div class="container">
      <header class="card border-light mb-3" style="height: 100px;">
        <div class="row g-0">
          <div class="col-5"><%= link_to(image_tag("/logo.png", height: 100, alt: "The Sanctuary Boston, home"), root_path) %></div>
          <div class="col-7">
            <div class="card-body">
              <span class="fs-4 card-title">Anti-Capitalist Community Auction!</span>
            </div>
          </div>
        </div>
      </header>

      <main>
        <%= yield %>
      </main>
      <hr>
      <footer>
        <% if admin_signed_in? %>
          <%= link_to "Admin Logout", destroy_admin_session_path,
              class: "btn btn-default bg-danger-subtle m-3" ,
              data: {
                turbo_method: :delete,
                turbo_confirm: "Are you sure?"
              } %>
        <% end %>
      </footer>
    </div>
  </body>
</html>
