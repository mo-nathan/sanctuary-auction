<% content_for :title, "Fairy Helper" %>
<%= render "tabs", tab: "ranking" %>

<h1>Fairy Helper</h1>

<p>Enter your user code to put the raffle items in your order of preference.</p>

<%= form_with url: ranking_path, data: { turbo: false } do |form| %>
  <div class="mt-3">
    <%= form.label :code, "User Code" %>
    <%= form.text_field :code, autocomplete: "off", required: true %>
  </div>

  <div class="mt-3">
    <%= form.submit "Continue", class: "btn btn-default btn-lg bg-info-subtle" %>
  </div>
<% end %>
